# Discord Developer Portal -> Bot -> Token
TOKEN=replace_with_your_bot_token

# Optional: server ID for instant slash-command updates.
# Enable Developer Mode in Discord, then right-click the server -> Copy Server ID.
GUILD_ID=replace_with_your_server_id

# Optional: use a mounted Railway volume path to keep warnings and verification links after redeploys.
# DATA_FILE=data/bot_data.json
