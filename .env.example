# Discord Developer Portal -> Bot -> Token
TOKEN=replace_with_your_bot_token

# Discord Developer Portal -> OAuth2 -> General -> Application ID
CLIENT_ID=replace_with_your_application_id

# Your Discord server ID (enable Developer Mode, then right-click the server -> Copy Server ID)
GUILD_ID=replace_with_your_server_id

# Set to false only if you do not want commands to refresh on each startup.
SYNC_COMMANDS=true
